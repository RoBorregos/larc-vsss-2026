<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>VSSS Simulator</title>

<style>
  body { 
    margin: 0; 
    background: #111; 
  }

  canvas { 
    display: block; 
    margin: auto; 
  }
</style>

</head>
<body>

<canvas id="field"></canvas>

<script>
const canvas = document.getElementById("field");
const ctx = canvas.getContext("2d");


// MEDIDAS REALES (en cm)

const FIELD_LENGTH = 150;
const FIELD_WIDTH  = 130;

const MID_X = FIELD_LENGTH / 2;

const DEFENDER_OFFSET_X = 25;  
const DEFENDER_OFFSET_Y = 0;   

const DEFENDER_MAX_FORWARD = MID_X + 5;

const VISUAL_CIRCLE_DIAMETER = 2.5;
const VISUAL_CIRCLE_RADIUS = VISUAL_CIRCLE_DIAMETER/2;
const VISUAL_CROSS_SIZE = 3.5;

const SCALE = 5;

canvas.width  = FIELD_LENGTH * SCALE;
canvas.height = FIELD_WIDTH  * SCALE;


// FÍSICAS

const DT = 0.016;
const FRICTION = 0.995;

const ROBOT_RADIUS = 3.75; // 7.5 cm diámetro
const BALL_RADIUS = 2.135; // golf real


// DIBUJAR ELEMENTOS VISUALES


function drawVisualCircle(x_cm, y_cm, color) {
    ctx.beginPath();
    ctx.arc(x_cm*SCALE, y_cm*SCALE, VISUAL_CIRCLE_RADIUS*SCALE, 0, 2*Math.PI);
    ctx.fillStyle = color;
    ctx.fill();
}

function drawVisualCross(x_cm, y_cm, color) {
    const x = x_cm * SCALE;
    const y = y_cm * SCALE;
    const size = VISUAL_CROSS_SIZE * SCALE / 2;

    ctx.strokeStyle = color;
    ctx.lineWidth = 2;

    ctx.beginPath();
    ctx.moveTo(x - size, y - size);
    ctx.lineTo(x + size, y + size);
    ctx.moveTo(x + size, y - size);
    ctx.lineTo(x - size, y + size);
    ctx.stroke();
}


// CANCHA


function drawField() {

    ctx.clearRect(0, 0, canvas.width, canvas.height);

    ctx.fillStyle = "#000000";
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    ctx.strokeStyle = "white";
    ctx.lineWidth = 2;

    ctx.strokeRect(0, 0, canvas.width, canvas.height);

    ctx.beginPath();
    ctx.moveTo(canvas.width / 2, 0);
    ctx.lineTo(canvas.width / 2, canvas.height);
    ctx.stroke();

    const CENTER_CIRCLE_RADIUS = 20 * SCALE;
    ctx.beginPath();
    ctx.arc(canvas.width/2, canvas.height/2, CENTER_CIRCLE_RADIUS, 0, 2*Math.PI);
    ctx.stroke();

    const AREA_DEPTH = 15 * SCALE;
    const AREA_HEIGHT = 70 * SCALE;

    ctx.strokeRect(0,
        canvas.height/2 - AREA_HEIGHT/2,
        AREA_DEPTH,
        AREA_HEIGHT);

    ctx.strokeRect(canvas.width - AREA_DEPTH,
        canvas.height/2 - AREA_HEIGHT/2,
        AREA_DEPTH,
        AREA_HEIGHT);

    // Tus marcadores
    drawVisualCircle(16,105,"white");
    drawVisualCircle(16,25,"white");
    drawVisualCircle(56,105,"white");
    drawVisualCircle(56,25,"white");
    drawVisualCircle(134,25,"white");
    drawVisualCircle(134,105,"white");
    drawVisualCircle(94,105,"white");
    drawVisualCircle(94,25,"white");

    drawVisualCross(38,105,"white");
    drawVisualCross(38,65,"white");
    drawVisualCross(38,25,"white");
    drawVisualCross(112,105,"white");
    drawVisualCross(112,65,"white");
    drawVisualCross(112,25,"white");
}


// ROBOT OMNI 3 RUEDAS


class OmniRobot {

    constructor(x,y){
        this.x = x;
        this.y = y;
        this.theta = 0;
        this.vx = 0;
        this.vy = 0;
        this.w = 0;
    }

    update(){

        this.x += this.vx * DT;
        this.y += this.vy * DT;
        this.theta += this.w * DT;

        this.vx *= FRICTION;
        this.vy *= FRICTION;

        // Colisión bordes
        this.x = Math.max(ROBOT_RADIUS, Math.min(FIELD_LENGTH-ROBOT_RADIUS, this.x));
        this.y = Math.max(ROBOT_RADIUS, Math.min(FIELD_WIDTH-ROBOT_RADIUS, this.y));
    }

    draw(color){
        ctx.save();
        ctx.translate(this.x*SCALE, this.y*SCALE);
        ctx.rotate(this.theta);

        ctx.fillStyle = color;
        ctx.beginPath();
        ctx.moveTo(ROBOT_RADIUS*SCALE,0);
        ctx.lineTo(-ROBOT_RADIUS*SCALE,ROBOT_RADIUS*SCALE);
        ctx.lineTo(-ROBOT_RADIUS*SCALE,-ROBOT_RADIUS*SCALE);
        ctx.closePath();
        ctx.fill();

        ctx.restore();
    }
}


//  PELOTA


const ball = {
    x:75,
    y:65,
    vx:0,
    vy:0,

    update(){
        this.x += this.vx*DT;
        this.y += this.vy*DT;

        this.vx *= FRICTION;
        this.vy *= FRICTION;

        if(this.x < BALL_RADIUS || this.x > FIELD_LENGTH-BALL_RADIUS)
            this.vx *= -1;

        if(this.y < BALL_RADIUS || this.y > FIELD_WIDTH-BALL_RADIUS)
            this.vy *= -1;
    },

    draw(){
        ctx.beginPath();
        ctx.arc(this.x*SCALE,this.y*SCALE,BALL_RADIUS*SCALE,0,2*Math.PI);
        ctx.fillStyle="orange";
        ctx.fill();
    }
};


// CREAR ROBOTS


const robot1 = new OmniRobot(30,40);
const robot2 = new OmniRobot(120,40);
const robot3 = new OmniRobot(75,100);


// POSICIONAR FÁCIL


function placeRobot(robot,x,y){
    robot.x = x;
    robot.y = y;
}


// COLISIÓN ROBOT-PELOTA

function collision(robot){
    const dx = ball.x - robot.x;
    const dy = ball.y - robot.y;
    const dist = Math.sqrt(dx*dx+dy*dy);

    if(dist < ROBOT_RADIUS + BALL_RADIUS){
        const nx = dx/dist;
        const ny = dy/dist;

        ball.vx = nx * 60;
        ball.vy = ny * 60;
    }
}


// LOOP PRINCIPAL


const MAX_LIN_SPEED = 150;   // cm/s
const MAX_ROT_SPEED = 10;    // rad/s

const WEIGHT_TIME  = 1.0;
const WEIGHT_ALIGN = 0.5;
const PENALTY_NO_KICKER = 1.5;
const HYSTERESIS_BONUS = 0.15;

const ATTACK_OFFSET = 5.0;

let currentAttacker = -1;

function normalizeAngle(a){
    while(a > Math.PI) a -= 2*Math.PI;
    while(a < -Math.PI) a += 2*Math.PI;
    return a;
}

function calculateTimeToAction(robot){

    const dx = ball.x - robot.x;
    const dy = ball.y - robot.y;
    const distance = Math.hypot(dx,dy);

    const dirx = dx / (distance || 1);
    const diry = dy / (distance || 1);

    const velTowardsBall = robot.vx*dirx + robot.vy*diry;

    let effectiveDist = distance - velTowardsBall * 0.2;
    if(effectiveDist < 0) effectiveDist = 0;

    const timeToReach = effectiveDist / MAX_LIN_SPEED;

    const angleToBall = Math.atan2(dy,dx);
    const angleError = normalizeAngle(angleToBall - robot.theta);

    const timeToAlign = Math.abs(angleError) / MAX_ROT_SPEED;

    return WEIGHT_TIME*timeToReach +
           WEIGHT_ALIGN*timeToAlign;
}

function applyStrategy(){

    const robots = [robot1, robot2, robot3];
    const GOALIE_INDEX = 0;

    //SELECT ATTACKER
    let costs=[];
    

    for(let i=1;i<3;i++){
        let cost = calculateTimeToAction(robots[i]);

        if(i === currentAttacker)
            cost -= HYSTERESIS_BONUS;
        
            costs.push({index:i,cost:cost});
    }
    //orden de menor  Mayor costo

    costs.sort((a,b)=>a.cost-b.cost);
    
    const attacker=costs[0].index;
    const defender = costs[1].index;
    const goalie   = GOALIE_INDEX;
    currentAttacker = attacker;

    //ATTACKER TARGET
    const enemyGoal = {x:65, y:150};
    const dirx = enemyGoal.x - ball.x;
    const diry = enemyGoal.y - ball.y;
    const norm = Math.hypot(dirx,diry) || 1;

    const attackPoint = {
        x: ball.x - (dirx/norm)*ATTACK_OFFSET,
        y: ball.y - (diry/norm)*ATTACK_OFFSET
    };

    moveRobotToGoal(robots[attacker], attackPoint.x, attackPoint.y);

    //DEFENDER TARGET
    const defGoal = {
        x:(ball.x+65)/2,
        y:(ball.y+0)/2
    };

    moveRobotToGoal(robots[defender], defGoal.x, defGoal.y);

    //GOALIE TARGET 
    const gk = {
        x: 8,
        y: Math.max(45, Math.min(85, ball.x)),
    };

    moveRobotToGoal(robots[goalie], gk.x, gk.y);
}

function moveRobotToGoal(robot, gx, gy){

    const dx = gx - robot.x;
    const dy = gy - robot.y;
    const dist = Math.hypot(dx,dy);

    const desiredAngle = Math.atan2(dy,dx);
    const angleError = normalizeAngle(desiredAngle - robot.theta);

    // Rotación
    robot.w = Math.max(-MAX_ROT_SPEED,
               Math.min(MAX_ROT_SPEED, angleError*5));

    // Traslación
    const speed = Math.min(MAX_LIN_SPEED, dist*2);

    robot.vx = Math.cos(robot.theta) * speed;
    robot.vy = Math.sin(robot.theta) * speed;
}

function update(){

    drawField();

    applyStrategy();   

    robot1.update();
    robot2.update();
    robot3.update();
    ball.update();

    collision(robot1);
    collision(robot2);
    collision(robot3);

    robot1.draw("blue");
    robot2.draw("red");
    robot3.draw("green");

    ball.draw();

    requestAnimationFrame(update);
}


placeRobot(robot1, 10, 65);
placeRobot(robot2, 45, 25);
placeRobot(robot3,  28, 105);




update();

</script>
